{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"disableSizeLimit": true,
		"module": "ESNext",
		"outDir": "dist/",
		"target": "ESNext",
		"isolatedModules": false,
		"noEmit": false,
		"declaration": true,
		"moduleResolution": "bundler",
		"rootDir": "./src",
		"jsx": "react-jsx",
		"paths": {
			"@dokploy/server/*": ["./src/*"],
			"@paas/branding": ["../branding/src/index.d.ts"]
		}
	},
	"include": ["./src/**/*"],

	"exclude": ["**/dist", "tsup.ts", "src/lib/auth-cli.ts"],
	"tsc-alias": {
		"resolveFullPaths": true,
		"verbose": false
	}
}
