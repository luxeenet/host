{
	"compilerOptions": {
		/* Base Options: */
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "es2022",
		"allowJs": true,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"isolatedModules": true,
		/* Strictness */
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"checkJs": true,
		/* Bundled projects */
		"lib": ["dom", "dom.iterable", "ES2022"],
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "preserve",
		"plugins": [{ "name": "next" }],
		"outDir": "./dist",
		"rootDir": "..",
		/* Path Aliases */
		"paths": {
			"@dokploy/server/*": ["./src/*"],
			"@paas/branding": ["../branding/src/index.ts"]
		}
	},
	"include": ["next-env.d.ts", "./src/**/*.ts", "../branding/src/**/*.ts"],

	"exclude": [
		"tsup.ts",
		"node_modules",
		"dokploy",
		"config",
		"dist",
		".next",
		"webpack.config.server.js",
		"migration.ts",
		"setup.ts"
	]
}
